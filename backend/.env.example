DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://educore:educore@postgres:5432/educore

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=educore
MINIO_SECRET_KEY=educore-dev-secret
MINIO_BUCKET_NAME=educore

JWT_SIGNING_KEY=change-me-too

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated hostnames exempt from tenant resolution (docs/multitenancy.md
# §2) — e.g. the platform admin/system-admin host. Empty in dev; dev.py
# hardcodes localhost/127.0.0.1/testserver instead since no real Domain
# rows exist locally yet.
PLATFORM_HOSTS=

SENTRY_DSN=
